# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Las capturas ya armadas para la ficha, con su marco y su texto abajo. Se
# hacen a mano y se guardan aparte: aca solo molestan, porque son megabytes que
# cambian enteros cada vez que se rehace una.
assets/caps/

# El material de la ficha de Play: las capturas que saca herramientas/captura.js
# y el icono y el grafico destacado, recortados de las imagenes del sitio. Se
# sube a Play, no al repo: son megabytes de PNG que se rearman cuando hacen
# falta, y las capturas se rehacen con cada build que se publica.
tienda/

# Lo que compila Gradle adentro de un modulo propio.
#
# `android/` entero ya esta ignorado mas arriba, pero los modulos de
# `modules/` tienen su propio `android/` y ese no cae en la misma regla. Sin
# esto, un `git add modules` se lleva los .dex y las cachés de transforms, que
# ademas tienen nombres tan largos que Windows ni siquiera los puede indexar.
modules/*/android/build/
modules/*/android/.cxx/

# Los entornos y todo lo que producen fotos.py, filtrar.py y entrenar.py: se
# regenera. Las fotos propias tampoco se suben.
modelo/.venv/
modelo/.venv-clip/
modelo/__pycache__/
modelo/cache/
modelo/candidatas/
modelo/datos/
modelo/salida/
modelo/propias/
