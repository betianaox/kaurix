{
  "expo": {
    "name": "Kaurix",
    "slug": "kaurix",
    "owner": "imagostack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4EDDF",
    "newArchEnabled": true,
    "android": {
      "package": "com.imagostack.kaurix",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Kaurix necesita la cámara para que encuentres huevos y objetos en el mundo real."
        }
      ],
      "./plugins/withAnimatedWebp",
      "./plugins/withKotlinJvmTarget",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5829308591228932~8823020495"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# ML Kit carga sus modelos por reflexión y R8 no lo ve.\n# `image-labeling`, que es el que usa el reconocedor, no trae reglas propias\n# en su AAR —`barcode-scanning` sí—, así que van acá.\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_** { *; }\n-dontwarn com.google.mlkit.**\n\n# El módulo nativo del color dominante, la otra mitad del reconocedor.\n-keep class com.reactnativeimagecolors.** { *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "backgroundColor": "#F4EDDF"
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "4d2be47e-1e02-4340-a6eb-ad8449ceb0c3"
      }
    }
  }
}
